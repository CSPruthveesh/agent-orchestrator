# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Async AI Agent Orchestration Platform"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# Storage Configuration
SQLITE_DB_PATH=orchestrator.db

# LLM Providers (Gemini Free Tier API Key)
GEMINI_API_KEY=AIzaSy...
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Optional LLM Providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Sandbox Quotas
SANDBOX_MAX_CPU_TIMEOUT_MS=5000
SANDBOX_MAX_MEMORY_MB=256

# Agent Limits
MAX_AGENT_TREE_DEPTH=3
MAX_WORKERS_PER_SUPERVISOR=5
DEFAULT_AGENT_BUDGET_USD=1.00
